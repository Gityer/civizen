# Copy to .env (web app) and fill in. Never commit real values.
# The local Supabase from scripts/local-supabase/up.sh prints its URL and keys when it starts.

# Web app (bundled into the client, so only public values)
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_PUBLISHABLE_KEY=
# testing | release; set by the release scripts for Android builds
VITE_DISTRIBUTION_CHANNEL=
# Allow seeding the demonstration budget in the funding admin (local only)
VITE_ALLOW_DEMO_BUDGET_SEED=

# Scripts and edge functions (server side only; keep these in .env.local)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# verify:* scripts sign in as seeded test users; passwords per role
TEST_USER_ROLE_MEMBER_PASSWORD=
TEST_USER_ROLE_CITIZEN_PASSWORD=
TEST_USER_ROLE_VERIFIED_MEMBER_PASSWORD=
