    "assistant:knowledge:check": "npx tsx scripts/assistant-knowledge.ts --check",
    "verify:agent-context": "node scripts/verify-agent-context.mjs",
    "verify:dev-load": "node scripts/verify-dev-app-load.mjs",
    "verify:arc-carousel-layout": "npx tsx scripts/verify-arc-carousel-layout.mjs",
    "verify:arc-carousel-visible": "node scripts/verify-arc-carousel-visible.mjs",
