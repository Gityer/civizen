    "verify:profile-score-dial": "node scripts/verify-profile-score-dial.mjs",
    "verify:happiness-foundation": "node scripts/verify-happiness-foundation.mjs",
    "verify:work-fulfillment": "node scripts/verify-work-fulfillment.mjs",
    "verify:fulfillment-plans": "node scripts/verify-fulfillment-plans.mjs",
    "verify:wellbeing-aggregate-privacy": "node scripts/verify-wellbeing-aggregate-privacy.mjs",
    "verify:wellbeing-insights": "node scripts/verify-wellbeing-insights.mjs",
    "verify:human-outcome-loop": "node scripts/verify-human-outcome-loop.mjs",
    "verify:matters-foundation": "node scripts/verify-matters-foundation.mjs",
    "verify:matters-detail": "node scripts/verify-matters-detail.mjs",
    "verify:matters-auth": "node scripts/verify-matters-auth.mjs",
    "verify:matters-work-detail": "node scripts/verify-matters-work-detail.mjs",
    "verify:matters-resolution-detail": "node scripts/verify-matters-resolution-detail.mjs",
