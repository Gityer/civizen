  "scripts": {
    "workspace:check": "bash scripts/check-workspace-drift.sh",
    "workspace:check:strict": "bash scripts/check-workspace-drift.sh --strict",
    "dev:auto": "vite",
    "dev": "npm run workspace:check && vite",
    "build": "npm run workspace:check && vite build",
    "build:dev": "vite build --mode development",
    "build:android": "npm run build && rm -rf dist/downloads && cp capacitor.config.android.json capacitor.config.json",
    "icons:generate": "node scripts/generate-icon-assets.mjs",
    "release:bump": "bash scripts/release-bump.sh",
    "update:application": "npm run workspace:check:strict && bash scripts/update-application.sh",
    "promote:android-testing-to-release": "node scripts/promote-android-testing-to-release.mjs",
    "cap:android": "npm run build:android && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "standards:check": "node scripts/check-engineering-standards.mjs",
    "lint": "npm run standards:check && eslint . --max-warnings=0",
    "audit:ci": "node scripts/audit-ci.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run src/pages/page-smoke.test.tsx src/pages/settings/UsersAdmin.test.tsx src/components/admin",
    "test-users:sync": "node scripts/sync-test-users.mjs",
    "test-users:cleanup-random": "node scripts/cleanup-random-test-users.mjs",
    "stories:backfill": "node scripts/backfill-development-stories.mjs",
