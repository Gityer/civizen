{
  "name": "civizen",
  "private": true,
  "version": "0.1.215",
  "type": "module",
  "engines": {
    "node": ">=24.18.1",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "workspace:check": "bash scripts/check-workspace-drift.sh",
    "workspace:check:strict": "bash scripts/check-workspace-drift.sh --strict",
    "dev:auto": "vite",
    "dev": "npm run workspace:check && vite",
    "build": "npm run workspace:check && vite build",
    "build:dev": "vite build --mode development",
    "build:android": "npm run build && rm -rf dist/downloads && cp capacitor.config.android.json capacitor.config.json",
    "icons:generate": "node scripts/generate-icon-assets.mjs",
    "release:bump": "bash scripts/release-bump.sh",
    "update:application": "npm run workspace:check:strict && bash scripts/update-application.sh",
    "promote:android-testing-to-release": "node scripts/promote-android-testing-to-release.mjs",
    "cap:android": "npm run build:android && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "standards:check": "node scripts/check-engineering-standards.mjs",
    "lint": "npm run standards:check && eslint . --max-warnings=0",
    "audit:ci": "node scripts/audit-ci.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "test:smoke": "vitest run src/pages/page-smoke.test.tsx src/pages/settings/UsersAdmin.test.tsx src/components/admin",
    "test-users:sync": "node scripts/sync-test-users.mjs",
    "test-users:cleanup-random": "node scripts/cleanup-random-test-users.mjs",
    "stories:backfill": "node scripts/backfill-development-stories.mjs",
    "stories:reconstruct-historical": "npx tsx scripts/reconstruct-historical-development-outcomes.ts",
    "db:apply-remote-migration": "bash scripts/db/apply-remote-migration.sh",
    "db:apply-remote:federation-distribution": "bash scripts/db/apply-remote-federation-distribution-migrations.sh",
    "db:vps-install-agent-key": "bash scripts/db/vps-install-agent-ssh-key.sh",
    "assistant:knowledge": "npx tsx scripts/assistant-knowledge.ts",
    "assistant:knowledge:check": "npx tsx scripts/assistant-knowledge.ts --check",
    "verify:agent-context": "node scripts/verify-agent-context.mjs",
    "verify:dev-load": "node scripts/verify-dev-app-load.mjs",
    "verify:arc-carousel-layout": "npx tsx scripts/verify-arc-carousel-layout.mjs",
    "verify:arc-carousel-visible": "node scripts/verify-arc-carousel-visible.mjs",
    "verify:home-post-composer": "node scripts/verify-home-post-composer.mjs",
    "verify:home-post-format": "node scripts/verify-home-post-format.mjs",
    "verify:post-likes-rls": "node scripts/verify-post-likes-rls.mjs",
    "verify:post-reposts": "node scripts/verify-post-reposts.mjs",
    "verify:post-edit": "node scripts/verify-post-edit.mjs",
    "verify:home-happiness-shortcut": "node scripts/verify-home-happiness-shortcut.mjs",
    "verify:profile-score-dial": "node scripts/verify-profile-score-dial.mjs",
    "verify:happiness-foundation": "node scripts/verify-happiness-foundation.mjs",
    "verify:work-fulfillment": "node scripts/verify-work-fulfillment.mjs",
    "verify:fulfillment-plans": "node scripts/verify-fulfillment-plans.mjs",
    "verify:wellbeing-aggregate-privacy": "node scripts/verify-wellbeing-aggregate-privacy.mjs",
    "verify:wellbeing-insights": "node scripts/verify-wellbeing-insights.mjs",
    "verify:human-outcome-loop": "node scripts/verify-human-outcome-loop.mjs",
    "verify:matters-foundation": "node scripts/verify-matters-foundation.mjs",
    "verify:matters-detail": "node scripts/verify-matters-detail.mjs",
    "verify:matters-auth": "node scripts/verify-matters-auth.mjs",
    "verify:matters-work-detail": "node scripts/verify-matters-work-detail.mjs",
    "verify:matters-resolution-detail": "node scripts/verify-matters-resolution-detail.mjs",
    "verify:matters-ai-detail": "node scripts/verify-matters-ai-detail.mjs",
    "verify:matters-coding-detail": "node scripts/verify-matters-coding-detail.mjs",
    "verify:matter-agent-auth": "node scripts/verify-matter-agent-auth.mjs",
    "verify:matter-agent-activation": "node scripts/verify-matter-agent-activation.mjs",
    "verify:single-world-citizenship": "node scripts/verify-single-world-citizenship.mjs",
    "verify:ci": "node scripts/verify-ci.mjs",
    "verify:pre-push": "node scripts/verify-pre-push.mjs",
    "verify:post-dev": "npm run verify:agent-context && npm run verify:dev-load && npm run verify:arc-carousel-layout && npm run verify:arc-carousel-visible && npm run verify:home-post-composer && npm run verify:home-post-format && npm run verify:post-likes-rls && npm run verify:post-reposts && npm run verify:post-edit && npm run verify:home-happiness-shortcut && npm run verify:profile-score-dial && npm run verify:happiness-foundation && npm run verify:work-fulfillment && npm run verify:fulfillment-plans && npm run verify:wellbeing-aggregate-privacy && npm run verify:wellbeing-insights && npm run verify:human-outcome-loop && npm run verify:matters-foundation && npm run verify:matters-auth && npm run verify:matters-detail && npm run verify:matters-work-detail && npm run verify:matters-resolution-detail && npm run verify:matter-agent-auth && npm run verify:matters-ai-detail && npm run verify:matters-coding-detail",
    "release:guard": "node scripts/verify-release-lifecycle.mjs",
    "release:testing": "CIVIZEN_UPDATE_CHANNEL=testing npm run update:application",
    "release:mark-tested": "npm run promote:android-testing-to-release && npm run build",
    "release:production:promote": "npm run promote:android-testing-to-release && npm run build"
  },
