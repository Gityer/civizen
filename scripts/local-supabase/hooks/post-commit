#!/usr/bin/env bash
# Installed by scripts/local-supabase/install-hooks.sh. After a commit, sync the local database only
# when that commit touched migrations.
git diff-tree --no-commit-id --name-only -r HEAD | grep -q '^supabase/migrations/' || exit 0
exec "$(git rev-parse --show-toplevel)/scripts/local-supabase/auto-sync.sh"
